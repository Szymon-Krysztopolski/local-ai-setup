{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen2.5-coder:14b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Ollama",
      "options": {
        "baseURL": "http://local-ai:11434/v1"
      },
      "models": {
        "qwen2.5-coder:14b": {
          "name": "Qwen 2.5 Coder 14B",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "write": "allow",
    "bash": "ask",
    "webfetch": "allow"
  },
  "instructions": [
    "/root/.config/opencode/AGENTS.md"
  ]
}
